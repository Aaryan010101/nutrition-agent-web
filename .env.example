# =============================================================================
# Thali & Pulse — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# --- IBM watsonx.ai ---
WATSONX_API_KEY=3R82qFNxoNR5N6E5nlyhkKz4GX5T0Vcv_-sdU0zZNOrC
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://api.jp-tok.watson-orchestrate.cloud.ibm.com/instances/374192ba-f11d-49ea-b699-6ac1c57c4f05

# Model IDs (defaults shown — change only if you prefer a different model)
WATSONX_REASONING_MODEL=ibm/granite-3-3-8b-instruct
WATSONX_FAST_MODEL=ibm/granite-3-3-2b-instruct
WATSONX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# --- Milvus vector store ---
# For local development, run: docker run -p 19530:19530 milvusdb/milvus:latest
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=indian_food_nutrition
